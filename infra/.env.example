# Lectern stack configuration (F§7.1). Copy this file to `infra/.env` and edit it there; that file is
# git-ignored, so no token ever reaches the repository.
#
#   cp -n infra/.env.example infra/.env

# F§11's single pre-shared bearer token, which every route except /healthz requires. F§7.1's floor is 32
# characters; replace this placeholder with at least that many random ones.
LECTERN_TOKEN=replace-with-at-least-32-random-characters

# Optional. Uncomment a line to switch that feature on, or to move the hub's port and data directory. An
# empty value counts as unset, so a commented line and an empty one mean the same thing.
# KOKORO_URL=http://kokoro:8880
# PIPER_URL=http://piper:5000
# LLM_BASE_URL=http://llm:11434/v1
# LLM_MODEL=
# LLM_API_KEY=
# LECTERN_PORT=8787
# LECTERN_DATA_DIR=/data
# LECTERN_ENABLE_MOCK=0
# LECTERN_MAX_UPLOAD_MB=100
# LECTERN_ALLOW_PRIVATE_FETCH=0
